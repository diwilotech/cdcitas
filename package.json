{
  "name": "cdcitas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:test": "node scripts/migrate-test.mjs",
    "test": "node scripts/test-local.mjs",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply control-de-citas-db --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply control-de-citas-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "worker-mailer": "^1.2.1"
  }
}
